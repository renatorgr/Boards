    (instances (project "AiO_Std45_XIAO_C3" (path "/b7d3c1a4-52e8-4f0b-9d61-3c8e2a7f5d21" (reference "#PWR05") (unit 1))))
  )
  (text "XIAO ESP32C3 / ESP32S3 adapter for the GPS2 socket of the AiO v4.5 Standard (headers P8, P7 and H14)" (at 25.40 25.40 0) (effects (font (size 2.0 2.0)) (justify left bottom)) (uuid c0909bef-ec1a-47e0-99f8-f2c54abe4526))
  (text "P8 pin 1 = Teensy RX2 (pin 7), P8 pin 2 = Teensy TX2 (pin 8): Serial2 of the Teensy. ESP32-C3: D6 = TX (GPIO21), D7 = RX (GPIO20). ESP32-S3: D6 = GPIO43, D7 = GPIO44." (at 25.40 31.75 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid b80ef6b2-b363-468d-afb9-6de03924805d))
  (text "Power: the 5 V of the socket (P7 pin 4, K7805M 1 A regulator of the board) through D1 to the 5V pin of the XIAO, as Seeed asks for an external 5 V supply." (at 25.40 35.56 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid bb2d7f93-2019-40bb-9a5b-e7c0fea2fdcf))
  (text "The 3.3 V of the socket (P7 pin 7) is the Teensy's own regulator and is NOT used. With D1, the USB-C of the XIAO may be plugged in with the adapter on the board." (at 25.40 39.37 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid ae251bb6-9d1f-45d0-bf78-853c670fdafc))
  (text "R1, R2: 1 k in series on the serial lines (protect the pins when only one side is powered, e.g. XIAO on USB with the AiO off)." (at 25.40 43.18 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid 7eaddb1e-006c-47af-929a-6611fec41c4d))
  (text "Not connected: P8 pin 3 (goes to the GPS1 socket), P7 pins 1, 5, 6, 7, 8 and the whole H14 (holds the adapter and stops it going in turned 180 degrees)." (at 25.40 46.99 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid fd0670b4-4b05-4eb9-a399-f8f8ad9f141e))

